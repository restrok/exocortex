BRAIN_HOST_DATA_DIR=./brain
BRAIN_DEFAULT_SPACE=work

# ==============================================================================
# LLM & Embedding Gateway Configuration
# Exocortex connects to any OpenAI-compatible API endpoint.
# ==============================================================================

# Option 1: OpenAI
BRAIN_LLM_BASE_URL=https://api.openai.com/v1
BRAIN_LLM_MODEL=gpt-4o-mini
BRAIN_REFLECTION_MODEL=gpt-4o
BRAIN_REFLECTION_REASONING_EFFORT=
BRAIN_EMBEDDING_MODEL=text-embedding-3-small
BRAIN_LLM_API_KEY=your-openai-api-key

# Option 2: Local Ollama (100% free & local, air-gapped)
# BRAIN_LLM_BASE_URL=http://localhost:11434/v1
# BRAIN_LLM_MODEL=qwen2.5-coder:7b
# BRAIN_REFLECTION_MODEL=qwen2.5-coder:7b
# BRAIN_REFLECTION_REASONING_EFFORT=
# BRAIN_EMBEDDING_MODEL=nomic-embed-text
# BRAIN_LLM_API_KEY=ollama

# Option 3: Google Gemini (Free tier via OpenAI-compatible endpoint)
# BRAIN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# BRAIN_LLM_MODEL=gemini-2.0-flash
# BRAIN_REFLECTION_MODEL=gemini-2.0-flash
# BRAIN_REFLECTION_REASONING_EFFORT=
# BRAIN_EMBEDDING_MODEL=text-embedding-004
# BRAIN_LLM_API_KEY=your-gemini-api-key

BRAIN_LLM_TIMEOUT_SECONDS=180
# Total wall-clock budget for one gateway request, including retries.
BRAIN_GATEWAY_WALL_TIMEOUT_SECONDS=120
# Shorter budget used by the extraction canary.
BRAIN_CANARY_TIMEOUT_SECONDS=30
BRAIN_GATEWAY_RETRY_ATTEMPTS=1
BRAIN_GATEWAY_RETRY_BACKOFF_SECONDS=0.25
BRAIN_EXTRACTION_MAX_CHARS=16000

# ==============================================================================
# Sessions Ingestion & Nightly Learning Cycle
# ==============================================================================
BRAIN_CODEX_SESSIONS_HOST_DIR=${HOME}/.codex/sessions
BRAIN_CODEX_SESSIONS_DIR=/sources/codex
BRAIN_SESSION_CLOSED_AFTER_SECONDS=1800
BRAIN_REFLECTION_HOUR=3
BRAIN_TIMEZONE=America/Argentina/Buenos_Aires
BRAIN_REFLECTION_MAX_NOTES=50

# Optional operational context for workflow ranking.
BRAIN_OPERATIONAL_CONTEXT_ENABLED=false
BRAIN_OPERATIONAL_ROLE=platform_engineering
BRAIN_OPERATIONAL_DOMAINS=gcp,terraform,kubernetes,docker,python,ci-cd
BRAIN_OPERATIONAL_COMMON_TASKS=infrastructure_changes,deployment_validation,pipeline_debugging
BRAIN_OPERATIONAL_PREFERRED_TOOLS=terraform,kubectl,gcloud,docker,pytest
BRAIN_OPERATIONAL_LOW_PRIORITY=generic_git_operations,one_off_documentation
BRAIN_OPERATIONAL_RISK_POLICY=high_confidence_and_low_risk

# ==============================================================================
# Neo4j Graph & Vector Store
# ==============================================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-a-strong-local-password

# ==============================================================================
# MCP (Model Context Protocol) Server
# ==============================================================================
BRAIN_MCP_HOST=127.0.0.1
BRAIN_MCP_PORT=8765
BRAIN_SYNC_INTERVAL_SECONDS=86400

# ==============================================================================
# Optional OpenTelemetry Observability Stack
# Enable with: COMPOSE_PROFILES=observability BRAIN_OTEL_ENABLED=true
# ==============================================================================
COMPOSE_PROFILES=
BRAIN_OTEL_ENABLED=false
BRAIN_OTEL_SERVICE_NAME=exocortex
BRAIN_OTEL_ENVIRONMENT=local
BRAIN_OTEL_EXPORTER_ENDPOINT=otel-collector:4317
BRAIN_OTEL_EXPORTER_INSECURE=true
BRAIN_OTEL_METRIC_EXPORT_INTERVAL_MS=10000
BRAIN_OTEL_SPAN_EXPORT_DELAY_MS=5000
